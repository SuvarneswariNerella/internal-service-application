generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  ACCOUNTS
  OPERATIONS
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ServerStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  DECOMMISSIONED
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String
  name      String
  role      Role        @default(DEVELOPER)
  avatar    String?
  isActive      Boolean     @default(true)
  totpSecret    String?
  isTotpEnabled Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  auditLogs AuditLog[]
  loginLogs LoginLog[]
  shortUrls ShortUrl[]
  qrCodes   QrCode[]
  assignedTickets MaintenanceRecord[] @relation("TicketAssignee")
  ticketComments  TicketComment[]
  statusChanges   TicketStatusHistory[]
}

model Client {
  id            String       @id @default(uuid())
  name          String
  company       String
  contactPerson String
  email         String
  phone         String?
  address       String?
  status        ClientStatus @default(ACTIVE)
  notes              String?
  retainer           Float?       @default(0)
  accountManagerLead String?
  workspaceId        String?
  workspace          Workspace?   @relation(fields: [workspaceId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  projects           Project[]
  domains            Domain[]
  servers            Server[]
  shortUrls          ShortUrl[]
  qrCodes            QrCode[]
  maintenanceRecords MaintenanceRecord[]
  financeRecords     FinanceRecord[]
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  technology  String?
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus @default(PLANNING)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  managerId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  billing     Billing[]
  assets      Asset?
  credentials Credential[]
  shortUrls   ShortUrl[]
  qrCodes     QrCode[]
  servers        Server[]
  domains        Domain[]
  financeRecords FinanceRecord[]
  maintenanceRecords MaintenanceRecord[]
  workspaceId    String?
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id])
}

model Billing {
  id            String        @id @default(uuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  billingType   String
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  dueDate       DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  invoiceNumber String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Asset {
  id            String   @id @default(uuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id])
  gitRepo       String?
  productionUrl String?
  stagingUrl    String?
  documentation String?
  database      String?
  apiCollection String?
  designFiles   String?
  customAssets  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Credential {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  portalName    String
  username      String
  password      String
  notes         String?
  assetCategory String?
  loginUrl      String?
  minRoleAccess String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Server {
  id              String       @id @default(uuid())
  name            String
  provider        String
  ipAddress       String?
  purchaseDate    DateTime?
  expiryDate      DateTime?
  renewalCost     Decimal?     @db.Decimal(10, 2)
  renewalFrequency String?
  status          ServerStatus @default(ACTIVE)
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workspaceId     String?
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id])
}

model Domain {
  id             String    @id @default(uuid())
  domain         String
  registrar      String?
  purchaseDate   DateTime?
  expirationDate DateTime?
  sslExpiration  DateTime?
  renewalCost    Decimal?  @db.Decimal(10, 2)
  dnsProvider    String?
  autoRenewal    Boolean   @default(false)
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
}

model ShortUrl {
  id           String     @id @default(uuid())
  originalUrl  String
  shortCode    String     @unique
  alias        String?
  clickCount   Int        @default(0)
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id])
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id])
  category     String?
  passwordHash String?
  status       String     @default("ACTIVE")
  tags         String?
  notes        String?
  createdBy    String?
  creator      User?      @relation(fields: [createdBy], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clicks       ClickLog[]
  qrCodes      QrCode[]
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
}

model ClickLog {
  id        String   @id @default(uuid())
  urlId     String
  url       ShortUrl @relation(fields: [urlId], references: [id])
  ip        String?
  userAgent String?
  referer   String?
  clickedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}

model QrCode {
  id                   String    @id @default(uuid())
  name                 String
  type                 String    @default("URL") // URL, TEXT, EMAIL, PHONE, SMS, WIFI, VCARD
  content              String    @db.Text
  rawContent           Json?
  clientId             String?
  client               Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId            String?
  project              Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shortUrlId           String?
  shortUrl             ShortUrl? @relation(fields: [shortUrlId], references: [id], onDelete: SetNull)
  format               String    @default("SVG") // SVG, PNG
  size                 Int       @default(256)
  foregroundColor      String    @default("#000000")
  backgroundColor      String    @default("#FFFFFF")
  errorCorrectionLevel String    @default("M") // L, M, Q, H
  expiryDate           DateTime?
  status               String    @default("ACTIVE") // ACTIVE, ARCHIVED, EXPIRED
  tags                 String?
  createdBy            String?
  creator              User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspaceId          String?
  workspace            Workspace? @relation(fields: [workspaceId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  entityId  String?
  entityType String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model AssetPlatform {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinanceRecord {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String   // INVOICE, RECEIPT, QUOTATION, CONTRACT, EXPENSE
  title     String
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  status    String   @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED, DRAFT
  dueDate   DateTime?
  paidDate  DateTime?
  fileUrl   String?
  notes     String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  emailLogs   EmailLog[]

  sourcePoId         String?
  convertedInvoiceId String?
  sourcePo           FinanceRecord?  @relation("POToInvoice", fields: [sourcePoId], references: [id], onDelete: SetNull)
  convertedInvoices  FinanceRecord[] @relation("POToInvoice")
}

model Workspace {
  id                String   @id @default(uuid())
  displayName       String
  shortCode         String
  contactEmail      String?
  legalName         String
  gstin             String?
  state             String?
  defaultCurrency   String   @default("INR")
  invoicePrefix     String?
  estimatePrefix    String?
  poPrefix          String?
  invoiceNextSeq    Int      @default(1)
  estimateNextSeq   Int      @default(1)
  poNextSeq         Int      @default(1)
  ticketPrefix      String?  @default("TKT")
  ticketNextSeq     Int      @default(1001)
  bankName          String?
  bankBranch        String?
  accountNumber     String?
  ifscCode          String?
  address           String?
  city              String?
  postalCode        String?
  country           String?
  activeClients     Int      @default(0)
  logoUrl           String?
  clients           Client[]
  projects          Project[]
  servers           Server[]
  domains           Domain[]
  shortUrls         ShortUrl[]
  qrCodes           QrCode[]
  financeRecords    FinanceRecord[]
  maintenanceRecords MaintenanceRecord[]
  notifications     Notification[]
  emailLogs         EmailLog[]
  designTemplates   DesignTemplate[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SystemSettings {
  id                    String   @id @default(uuid())
  agencyName            String?
  baseCurrency          String?
  timezone              String?
  smtpHost              String?
  smtpPort              String?
  smtpUsername          String?
  smtpPassword          String?
  smtpSenderName        String?
  smtpSenderEmail       String?
  transactionalEmailKey String?
  slackWebhookUrl       String?
  domainRegistrarSecret String?
  updatedAt             DateTime @updatedAt
}

model MaintenanceRecord {
  id            String    @id @default(uuid())
  ticketNumber  String?   @unique
  title         String
  description   String?   @db.Text
  type          String    @default("MAINTENANCE")
  status        String    @default("PENDING")
  priority      String    @default("MEDIUM")
  scheduledDate DateTime?
  completedDate DateTime?
  targetCompletionDate DateTime?
  
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id])
  assigneeId    String?
  assigneeName  String?
  assignee      User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments      TicketComment[]
  statusHistory TicketStatusHistory[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TicketComment {
  id                  String   @id @default(uuid())
  maintenanceRecordId String
  maintenanceRecord   MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  content             String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model EmailLog {
  id              String   @id @default(uuid())
  financeRecordId String
  financeRecord   FinanceRecord @relation(fields: [financeRecordId], references: [id], onDelete: Cascade)
  sender          String
  recipient       String
  subject         String
  content         String   @db.Text
  status          String   @default("SENT")
  sentAt          DateTime @default(now())
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id])
}

model DesignTemplate {
  id          String    @id @default(uuid())
  type        String    // INVOICES, PROPOSALS, PURCHASE_ORDERS
  design      String    // BRANDED COLOR-HEADER, CLASSIC, etc.
  isDefault   Boolean   @default(false)
  title       String
  description String?   @db.Text
  customHtml  String?   @db.Text
  customCss   String?   @db.Text
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TicketStatusHistory {
  id                  String   @id @default(uuid())
  maintenanceRecordId String
  maintenanceRecord   MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  status              String
  changedById         String?
  changedBy           User?    @relation(fields: [changedById], references: [id])
  enteredAt           DateTime @default(now())
  exitedAt            DateTime?
  durationMinutes     Int?
}
